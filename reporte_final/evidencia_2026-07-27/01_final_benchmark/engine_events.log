s no usable values.\n    \"\"\"\n    result = {}\n    for c in columns:\n        values = []\n        for row in rows:\n            val = row.get(c)\n            if _is_missing(val):\n                continue\n            try:\n                values.append(float(val))\n            except (ValueError, TypeError):\n                raise ValueError(f\"Invalid numeric data in column '{c}'\")\n        if not values:\n            raise ValueError(f\"No usable values in column '{c}'\")\n        result[c] = {\n            \"count\": len(values),\n            \"mean\": sum(values) / len(values),\n            \"min\": min(values),\n            \"max\": max(values),\n        }\n    return result"}]
